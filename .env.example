# Copy to .env and fill in the required values.
# Values shown are the defaults from app/config.py unless marked REQUIRED.

# --- Required ---
# REQUIRED. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# REQUIRED. At least 32 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=

# --- Production (docker-compose.prod.yml only) ---
# Public domain whose DNS A record points at the server; Caddy issues the HTTPS certificate for it.
DOMAIN=
# URL-safe value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
POSTGRES_PASSWORD=

# --- Infrastructure ---
# docker compose overrides QDRANT_URL, DATABASE_URL and CORS_ALLOWED_ORIGINS for the backend container;
# these values apply when running the backend directly on the host.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=contracts
DATABASE_URL=postgresql+psycopg2://contractai:contractai@localhost:54321/contractai
# Comma-separated list of frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# --- Rate limits ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_QUERY_PER_MINUTE=20

# --- Uploads ---
UPLOAD_DIR=data/uploads
UPLOAD_MAX_MB=20

# --- Embedding ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# cpu or cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# --- Chunking ---
CHUNKING_MAX_CHARS=1500
CHUNKING_OVERLAP_CHARS=200

# --- Retrieval ---
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_LIMIT=20
RETRIEVAL_RRF_K=60
# 0 disables the off-topic pre-filter; calibrate with `python -m app.eval.retrieval calibrate`.
RETRIEVAL_MIN_DENSE_SCORE=0
# Rejects off-topic questions ("1+1 bằng bao nhiêu?") before search and reranking,
# by comparing them with example questions in app/retrieval/topic_anchors.py. -1 disables it.
RETRIEVAL_TOPIC_MIN_MARGIN=-0.02

# --- Reranking ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANK_MIN_SCORE=0.05

# --- Generation ---
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
